# NetBox API Configuration
NETBOX_URL=http://localhost:8000
NETBOX_TOKEN=your_netbox_api_token_here
NETBOX_SITE_ID=

# Network Device SSH Credentials
DEVICE_USERNAME=cisco_ssh_user
DEVICE_PASSWORD=cisco_ssh_password

# Prometheus Observability Integration
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=10.0
PROMETHEUS_STALE_THRESHOLD_SECONDS=120.0
ENABLE_OBSERVABILITY_CHECK=true

# Observability Alerting Thresholds
CPU_WARNING_THRESHOLD=75.0
CPU_CRITICAL_THRESHOLD=90.0
MEMORY_WARNING_THRESHOLD=80.0
MEMORY_CRITICAL_THRESHOLD=90.0
BANDWIDTH_WARNING_THRESHOLD=80.0
BANDWIDTH_CRITICAL_THRESHOLD=90.0
LATENCY_WARNING_MS=500.0
LATENCY_CRITICAL_MS=2000.0

